# Infra local (valores do docker-compose.yml — apenas desenvolvimento)
# Aplicação: role sem privilégios, sujeita à RLS
DATABASE_URL=postgresql://comanda_app:comanda_app@localhost:5434/comanda
# Migrations e preparação de testes: dono das tabelas (ignora a RLS)
DATABASE_ADMIN_URL=postgresql://comanda:comanda@localhost:5434/comanda
REDIS_URL=redis://localhost:6381

# Segredos: gere valores próprios e nunca commite valores reais. Para gerar:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
ENCRYPTION_KEY=

# Meta (WhatsApp Cloud API e Instagram). Os segredos vêm do app da Meta.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Desenvolvimento sem credenciais reais: simula os envios e permite usar o simulador de webhooks.
CHANNELS_DRY_RUN=true

# iFood (credencial centralizada da plataforma). Sem ela, o polling de pedidos fica desligado.
# IFOOD_CLIENT_ID=
# IFOOD_CLIENT_SECRET=

# Logs: fatal, error, warn, info, debug, trace ou silent.
LOG_LEVEL=info

# Sentry da API (opcional; sem DSN fica desligado). O do painel entra no build da imagem: --build-arg NEXT_PUBLIC_SENTRY_DSN=...
SENTRY_DSN=

# Painel das filas (Bull Board) em /api/admin/filas, com Basic auth. Sem senha (mín. 12 caracteres), o painel não existe.
# BULL_BOARD_USER=admin
# BULL_BOARD_PASSWORD=
