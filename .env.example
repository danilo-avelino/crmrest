# Infra local (valores do docker-compose.yml — apenas desenvolvimento)
# Aplicação: role sem privilégios, sujeita à RLS
DATABASE_URL=postgresql://comanda_app:comanda_app@localhost:5434/comanda
# Migrations e preparação de testes: dono das tabelas (ignora a RLS)
DATABASE_ADMIN_URL=postgresql://comanda:comanda@localhost:5434/comanda
REDIS_URL=redis://localhost:6381

# Segredos: gere valores próprios e nunca commite valores reais. Para gerar:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
ENCRYPTION_KEY=

# Meta (WhatsApp Cloud API e Instagram). Os segredos vêm do app da Meta.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Chave secreta do app do Instagram (Casos de uso > API do Instagram): assina os webhooks do Instagram.
INSTAGRAM_APP_SECRET=
# Botão "Conectar com o Instagram": id do app do Instagram e o endereço de retorno cadastrado nele
# (Casos de uso > API do Instagram > Configurar login comercial do Instagram). Sem o retorno: WEB_ORIGIN/api/integrations/instagram/callback.
# INSTAGRAM_APP_ID=
# INSTAGRAM_REDIRECT_URI=
# Botão "Conectar WhatsApp" (cadastro incorporado, com Coexistência): id do app da Meta e o id da configuração
# criada em Login do Facebook para Empresas > Configurações (variação "Cadastro incorporado do WhatsApp").
# META_APP_ID=
# META_EMBEDDED_SIGNUP_CONFIG_ID=
# WhatsApp por QR Code (Evolution API, serviço "evolution" do docker-compose). A chave é a mesma que o docker-compose
# passa à Evolution; o webhook sai do container para a API de dev no host. O token vai em todo webhook (gere um valor).
# EVOLUTION_API_URL=http://localhost:8085
# EVOLUTION_API_KEY=dev-evolution-key
# EVOLUTION_WEBHOOK_URL=http://host.docker.internal:4000/api/webhooks/evolution
# EVOLUTION_WEBHOOK_TOKEN=
# Desenvolvimento sem credenciais reais: simula os envios e permite usar o simulador de webhooks.
CHANNELS_DRY_RUN=true

# Módulo Atendimento com IA (ligado por restaurante em /plataforma): LLM no formato da OpenAI. Em dev, o serviço
# "ollama" do docker-compose (baixe o modelo uma vez: docker compose exec ollama ollama pull gemma4:12b).
# Sem AI_BASE_URL, a IA fica desligada. AI_API_KEY só para um provedor na nuvem.
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=gemma4:12b
# AI_API_KEY=
# Reserva, quando a principal está fora do ar: "openai" (ex.: o Ollama da VPS, só CPU: prazo maior) ou "anthropic"
# (a API do Claude: AI_FALLBACK_API_KEY com a chave e AI_FALLBACK_MODEL=claude-haiku-5-5, sem AI_FALLBACK_BASE_URL).
# AI_FALLBACK_PROVIDER=openai
# AI_FALLBACK_BASE_URL=
# AI_FALLBACK_MODEL=qwen3.5:4b
# AI_FALLBACK_API_KEY=
# AI_FALLBACK_TIMEOUT_MS=180000

# Jev (modelo de decisão da TypeSafe AI, pela API Decisions do OpenRouter): analisa os casos suspeitos da defesa da API
# (sondagem de .env/.git, varredura de rotas, abuso de login) e avalia os atendimentos (E29). JEV_API_KEY é a chave do
# OpenRouter. Sem ela, as regras da defesa banem do mesmo jeito, sem a análise, e os atendimentos não são avaliados.
# JEV_API_KEY=
# JEV_MODEL=typesafe/jev-1.14
# "watch" (padrão): a defesa só registra o que teria banido, para conferir os IPs na tela antes; "ban": bane sozinha.
# DEFENSE_MODE=watch
# IPs ou faixas que nunca são banidos (o do escritório), separados por vírgula. A rede interna e a Fastly já ficam de fora.
# DEFENSE_ALLOW_IPS=

# iFood (credencial do aplicativo). Sem ela, o polling de pedidos fica desligado.
# IFOOD_CLIENT_ID=
# IFOOD_CLIENT_SECRET=
# Aplicativo distribuído: cada loja autoriza pelo código de vinculação em Configurações → Integrações. Sem a variável,
# vale o centralizado (a credencial enxerga todas as lojas que autorizaram o app no Portal).
# IFOOD_APP_TYPE=distributed
# Widget do iFood (chat com o cliente, em todas as telas do Dish Desk): Portal do Desenvolvedor → Widgets → Cadastrar Widget.
# IFOOD_WIDGET_ID=
# Chat do iFood na Inbox pela extensão do Chrome (apps/extension). Trava: "true" liga, sem a variável fica desligado.
# IFOOD_CHAT_BRIDGE=true
# Pesquisa de satisfação (nota de 1 a 5) no fim do atendimento: suspensa desde 14/11/2026. "true" liga de novo.
# SURVEY_ENABLED=true
# Botões de confirmar, marcar como pronto, despachar e cancelar o pedido do iFood. Sem a variável, o Dish Desk só
# acompanha os pedidos (quem opera é o sistema de pedidos da loja). Ligar para a homologação do iFood.
# IFOOD_ORDER_ACTIONS=true
# Só o cancelamento do pedido do iFood (alerta de fraude), sem liberar confirmar, pronto nem despachar. Sem a variável,
# o cancelamento depende de IFOOD_ORDER_ACTIONS.
# IFOOD_ORDER_CANCEL=true
# Página da extensão na Chrome Web Store: sem a extensão no navegador, a Inbox mostra o botão "Instalar" com este endereço.
# IFOOD_EXTENSION_URL=https://chromewebstore.google.com/detail/...

# Cardápio Web (pedidos do cardápio digital). Sem o endereço, o polling fica desligado; a chave de API é de cada loja (pnpm channel:add).
# Sandbox: https://integracao.sandbox.cardapioweb.com
# CARDAPIO_WEB_API_URL=https://integracao.cardapioweb.com

# Neemo (Linx Delivery App). Sem o endereço, o polling fica desligado; o token é de cada loja (Configurações → Integrações).
# NEEMO_API_URL=https://deliveryapp.neemo.com.br/api/integration

# Stripe (plano mensal depois do teste grátis: R$ 149/mês no cartão, renovado sozinho). Sem a chave, o checkout do mensal responde 503.
# O segredo é o do endpoint de webhook (<site>/api/webhooks/stripe), com os eventos checkout.session.completed e invoice.paid.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# InfinitePay (plano anual: R$ 1.490 no cartão em até 10x sem juros ou no Pix). Ligue "Habilitar checkout integrado" em
# Configurações do Checkout e crie a chave lá. O webhook vai em cada link (<WEB_ORIGIN>/api/webhooks/infinitepay), sem
# cadastro no painel. Sem as duas, o checkout do anual responde 503.
# INFINITEPAY_HANDLE=
# INFINITEPAY_API_KEY=

# Supabase Auth: manda o e-mail de "Esqueceu?" (o login continua sendo o nosso). Sem as duas, a recuperação responde 503.
# A chave é a secreta (service_role) do projeto; o retorno <WEB_ORIGIN>/redefinir-senha precisa estar em Redirect URLs.
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SECRET_KEY=
# "Continuar com Google" no login: cliente OAuth (Aplicativo da Web) do Google Cloud, com o retorno
# <WEB_ORIGIN>/api/auth/google/callback. Só entra quem já tem conta com o mesmo e-mail. Sem os dois, o botão avisa que não está disponível.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Logs: fatal, error, warn, info, debug, trace ou silent.
LOG_LEVEL=info

# Sentry da API (opcional; sem DSN fica desligado). O do painel entra no build da imagem: --build-arg NEXT_PUBLIC_SENTRY_DSN=...
SENTRY_DSN=

# ID da extensão do Chrome (o fim do endereço na Chrome Web Store; vírgula entre vários). Entra no build do painel:
# --build-arg NEXT_PUBLIC_EXTENSION_IDS=... Sem ele, em produção o assistente da extensão não abre.
# NEXT_PUBLIC_EXTENSION_IDS=

# Painel das filas (Bull Board) em /api/admin/filas, com Basic auth. Sem senha (mín. 12 caracteres), o painel não existe.
# BULL_BOARD_USER=admin
# BULL_BOARD_PASSWORD=
