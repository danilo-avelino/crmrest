# Substitua SEU_DOMINIO pelo seu dominio real (ex: app.comanda.com.br)
# O Caddy obtém HTTPS automaticamente via Let's Encrypt

SEU_DOMINIO {
    # Painel Next.js
    reverse_proxy comanda-web:3000

    # Headers de segurança
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
    }
}

