// Modelo de dados do Dish Desk (PROJETO_CRM_RESTAURANTES.md §7).
// Toda tabela de negócio tem tenant_id e RLS; as políticas ficam na migration tenant_isolation.
// Modelos de fases futuras (segmentos, templates, campanhas) entram junto com seus épicos.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Plataforma ----------

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum TenantRole {
  ADMIN
  AGENT
}

enum BillingPlan {
  MONTHLY
  ANNUAL
}

// Módulos pagos à parte do plano (o Campanhas, Fase 3).
enum ModuleKey {
  CAMPAIGNS
}

model Tenant {
  id        String       @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  settings  Json         @default("{}") // horário de funcionamento, textos automáticos, links para pedir (orderLinks)...
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  // Cadastro pelo site: teste grátis até trialEndsAt e, depois, acesso até paidUntil. Sem trialEndsAt (restaurante
  // criado pela plataforma) não há teste nem cobrança. trialRevokedAt: teste encerrado antes da hora porque um canal
  // conectado já tinha passado por outro teste grátis (app.claim_channel). trustUntil: assinatura vencida com o acesso
  // liberado por confiança até esta data, uma vez por atraso (app.release_tenant_trust). billingPlan: último plano pago.
  // Restaurante adicionado por quem já tem conta (app.add_tenant) não tem teste: trialEndsAt igual a createdAt.
  trialEndsAt     DateTime?    @map("trial_ends_at") @db.Timestamptz(3)
  trialRevokedAt   DateTime?    @map("trial_revoked_at") @db.Timestamptz(3)
  paidUntil        DateTime?    @map("paid_until") @db.Timestamptz(3)
  trustUntil       DateTime?    @map("trust_until") @db.Timestamptz(3)
  billingPlan      BillingPlan? @map("billing_plan")
  contactPhone     String?      @map("contact_phone") // WhatsApp de quem se cadastrou (E.164)
  taxId            String?      @map("tax_id") // CPF ou CNPJ para a nota fiscal, sem pontuação
  stripeCustomerId String?      @unique @map("stripe_customer_id")

  members             TenantMember[]
  billingPayments     BillingPayment[]
  channels            Channel[]
  contacts            Contact[]
  contactIdentities   ContactIdentity[]
  contactAddresses    ContactAddress[]
  duplicateDismissals ContactDuplicateDismissal[]
  consents            Consent[]
  conversations       Conversation[]
  messages            Message[]
  orders              Order[]
  orderItems          OrderItem[]
  orderEvents         OrderEvent[]
  ratings             Rating[]
  quickReplies        QuickReply[]
  auditLogs           AuditLog[]
  modules             TenantModule[]

  @@map("tenants")
}

// Módulo ligado num restaurante. Só a plataforma liga e desliga (app.set_tenant_module); o restaurante só lê.
model TenantModule {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  module    ModuleKey
  enabledAt DateTime  @default(now()) @map("enabled_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, module])
  @@map("tenant_modules")
}

model User {
  id           String  @id @default(uuid(7)) @db.Uuid
  name         String
  email        String  @unique
  passwordHash String  @map("password_hash")
  isSuperAdmin Boolean @default(false) @map("is_super_admin") // equipe da plataforma
  isActive     Boolean @default(true) @map("is_active")

  memberships           TenantMember[]
  sessions              Session[]
  assignedConversations Conversation[]
  sentMessages          Message[]
  auditLogs             AuditLog[]

  @@map("users")
}

// Sessão de login: guarda o hash do refresh token e o restaurante (ou painel master) escolhido.
model Session {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") // sha256 do segredo do refresh token
  context   Json? // { mode: 'tenant', tenantId } | { mode: 'master' }; null = ainda não escolheu
  userAgent String?   @map("user_agent")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Um usuário pode pertencer a vários tenants, com um papel em cada (painel master, §5.1.1).
model TenantMember {
  tenantId  String     @map("tenant_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  role      TenantRole
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tenantId, userId])
  @@index([userId])
  @@map("tenant_members")
}

// Pagamento confirmado pela Stripe. O id é o da fatura (mensal) ou da sessão de checkout (anual): o mesmo evento
// reenviado não conta duas vezes. Só a função app.record_tenant_payment grava.
model BillingPayment {
  id          String      @id
  tenantId    String      @map("tenant_id") @db.Uuid
  plan        BillingPlan
  amountCents Int         @map("amount_cents")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("billing_payments")
}

// ---------- Canais ----------

enum ChannelType {
  WHATSAPP
  INSTAGRAM
  MESSENGER
  IFOOD
  WEBCHAT
  CARDAPIO_WEB
}

enum ChannelStatus {
  CONNECTED
  ERROR
  DISCONNECTED
}

model Channel {
  id          String        @id @default(uuid(7)) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  type        ChannelType
  name        String
  externalId  String        @map("external_id") // phone_number_id, id da conta IG, merchant id
  credentials Bytes // criptografado (AES-256-GCM)
  status      ChannelStatus
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz(3) // integração excluída: some do painel, o histórico fica
  connectedAt DateTime?     @map("connected_at") @db.Timestamptz(3) // o que aconteceu antes de conectar não aciona automações
  // WhatsApp ou Instagram que atende várias unidades: outros restaurantes do mesmo administrador cujos pedidos o
  // atendimento deste canal também procura (Configurações → Integrações). As conversas continuam neste restaurante.
  servedTenantIds String[] @default([]) @map("served_tenant_ids") @db.Uuid
  // Vencimento do token do WhatsApp ou do Instagram (o job diário renova antes); null = não vence ou não conferido.
  tokenExpiresAt DateTime? @map("token_expires_at") @db.Timestamptz(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  messages      Message[]
  orders        Order[]

  @@unique([type, externalId])
  @@index([tenantId])
  @@map("channels")
}

// ---------- Clientes ----------

model Contact {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  name         String?
  phone        String? // E.164
  phoneSource  String?   @map("phone_source") // 'channel' | 'informed_by_customer' | 'agent'
  phoneStatus  String?   @map("phone_status") // 'ok' | 'pending' | 'refused'
  email        String?
  cpfEncrypted Bytes?    @map("cpf_encrypted")
  cpfHash      String?   @map("cpf_hash") // HMAC-SHA256, para busca e deduplicação
  birthDate    DateTime? @map("birth_date") @db.Date
  notes        String?
  tags         String[]  @default([])
  firstSeenAt  DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt   DateTime? @map("last_seen_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3) // LGPD: anonimização

  tenant        Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  identities    ContactIdentity[]
  addresses     ContactAddress[]
  consents      Consent[]
  conversations Conversation[]
  orders        Order[]
  dismissedAsA  ContactDuplicateDismissal[] @relation("DismissedA")
  dismissedAsB  ContactDuplicateDismissal[] @relation("DismissedB")

  @@index([tenantId, phone])
  @@index([tenantId, cpfHash])
  @@index([tenantId, lastSeenAt])
  @@map("contacts")
}

model ContactIdentity {
  id          String      @id @default(uuid(7)) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  contactId   String      @map("contact_id") @db.Uuid
  channelType ChannelType @map("channel_type")
  externalId  String      @map("external_id") // wa_id, IGSID, id do cliente no iFood
  profile     Json        @default("{}")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([tenantId, channelType, externalId])
  @@index([tenantId, contactId])
  @@map("contact_identities")
}

model ContactAddress {
  id         String  @id @default(uuid(7)) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  contactId  String  @map("contact_id") @db.Uuid
  label      String?
  street     String
  number     String?
  district   String?
  city       String
  state      String
  zipCode    String? @map("zip_code")
  complement String?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId, contactId])
  @@map("contact_addresses")
}

// Par que o admin marcou como "não são a mesma pessoa": sai da fila de possíveis duplicados.
model ContactDuplicateDismissal {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  contactAId String   @map("contact_a_id") @db.Uuid // sempre o menor id do par
  contactBId String   @map("contact_b_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactA Contact @relation("DismissedA", fields: [contactAId], references: [id], onDelete: Cascade)
  contactB Contact @relation("DismissedB", fields: [contactBId], references: [id], onDelete: Cascade)

  @@unique([contactAId, contactBId])
  @@index([tenantId])
  @@map("contact_duplicate_dismissals")
}

model Consent {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  contactId String   @map("contact_id") @db.Uuid
  purpose   String // 'marketing_whatsapp', 'data_collection'...
  granted   Boolean
  source    String // canal/forma da coleta
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId, contactId])
  @@map("consents")
}

// ---------- Atendimento ----------

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
}

enum Direction {
  INBOUND
  OUTBOUND
  INTERNAL // notas e eventos do sistema: nunca vão para o cliente
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  LOCATION
  STICKER
  SYSTEM
  NOTE
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model Conversation {
  id                 String             @id @default(uuid(7)) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  contactId          String             @map("contact_id") @db.Uuid
  channelId          String             @map("channel_id") @db.Uuid
  status             ConversationStatus
  assignedUserId     String?            @map("assigned_user_id") @db.Uuid
  automationState    Json               @default("{}") @map("automation_state") // ex.: { phoneCollection: 'awaiting_phone' }
  lastMessageAt      DateTime?          @map("last_message_at") @db.Timestamptz(3)
  windowExpiresAt    DateTime?          @map("window_expires_at") @db.Timestamptz(3) // janela de 24h
  awaitingAgentSince DateTime?          @map("awaiting_agent_since") @db.Timestamptz(3) // automação chamou a equipe e ninguém respondeu ainda
  awaitingAgentQuiet Boolean            @default(false) @map("awaiting_agent_quiet") // chamado sem urgência: aviso sonoro discreto no lugar do alarme
  unreadCount        Int                @default(0) @map("unread_count")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact      Contact   @relation(fields: [contactId], references: [id], onDelete: NoAction)
  channel      Channel   @relation(fields: [channelId], references: [id], onDelete: NoAction)
  assignedUser User?     @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages     Message[]
  orders       Order[]
  ratings      Rating[]

  @@index([tenantId, status, lastMessageAt])
  @@index([tenantId, contactId])
  @@map("conversations")
}

model Message {
  id                String         @id @default(uuid(7)) @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  conversationId    String         @map("conversation_id") @db.Uuid
  channelId         String         @map("channel_id") @db.Uuid
  externalMessageId String?        @map("external_message_id")
  direction         Direction
  type              MessageType
  content           Json // texto, mídia (chave S3), template...
  status            MessageStatus? // só mensagens de canal têm status
  statusError       String?        @map("status_error") // motivo da falha no envio
  sentByUserId      String?        @map("sent_by_user_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  channel      Channel      @relation(fields: [channelId], references: [id], onDelete: NoAction)
  sentByUser   User?        @relation(fields: [sentByUserId], references: [id], onDelete: SetNull)

  @@unique([channelId, externalMessageId]) // idempotência de webhooks duplicados
  @@index([tenantId, conversationId, createdAt])
  @@map("messages")
}

// Resposta rápida: o atendente digita "/" no composer e escolhe pelo atalho.
model QuickReply {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  shortcut  String // sem a barra, ex.: "atraso"
  content   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, shortcut])
  @@map("quick_replies")
}

// ---------- Pedidos (iFood e futuras origens) ----------

enum OrderStatus {
  PLACED
  CONFIRMED
  PREPARING
  READY // pronto para retirada ou entrega
  DISPATCHED
  DELIVERED
  CANCELED
}

model Order {
  id              String      @id @default(uuid(7)) @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  contactId       String      @map("contact_id") @db.Uuid
  channelId       String      @map("channel_id") @db.Uuid
  conversationId  String?     @map("conversation_id") @db.Uuid
  externalOrderId String      @map("external_order_id") // id do pedido no iFood
  displayCode     String?     @map("display_code") // código curto exibido (#485329)
  status          OrderStatus
  subtotal        Decimal     @db.Decimal(10, 2)
  deliveryFee     Decimal     @map("delivery_fee") @db.Decimal(10, 2)
  total           Decimal     @db.Decimal(10, 2)
  deliveryAddress Json?       @map("delivery_address")
  placedAt        DateTime    @map("placed_at") @db.Timestamptz(3)
  dispatchedAt    DateTime?   @map("dispatched_at") @db.Timestamptz(3)
  deliveredAt     DateTime?   @map("delivered_at") @db.Timestamptz(3)
  raw             Json // payload original

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact      Contact       @relation(fields: [contactId], references: [id], onDelete: NoAction)
  channel      Channel       @relation(fields: [channelId], references: [id], onDelete: NoAction)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  ratings      Rating[]
  events       OrderEvent[]

  @@unique([channelId, externalOrderId])
  @@index([tenantId, contactId, placedAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid(7)) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  name      String
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2) // já com os complementos escolhidos
  notes     String?
  options   String[] @default([]) // complementos escolhidos, como a equipe lê: "1× Bacon"

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId])
  @@map("order_items")
}

// Linha do tempo do pedido como a plataforma informou (iFood: PLACED, CONFIRMED, READY_TO_PICKUP, COLLECTED...).
// Base dos tempos de preparo e da previsão de saída (E26).
model OrderEvent {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  orderId         String   @map("order_id") @db.Uuid
  externalEventId String   @map("external_event_id") // id do evento na plataforma (idempotência)
  code            String // ex.: READY_TO_PICKUP
  occurredAt      DateTime @map("occurred_at") @db.Timestamptz(3)
  metadata        Json?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, externalEventId])
  @@index([tenantId, code, occurredAt])
  @@map("order_events")
}

// Pesquisa de satisfação no fim de um atendimento sobre um pedido: "Qual nota você dá...? 1 a 5".
model Rating {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  orderId        String?  @map("order_id") @db.Uuid
  score          Int // 1 a 5
  channelType    ChannelType @map("channel_type") // canal em que a nota foi dada (filtros dos relatórios)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  order        Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("ratings")
}

// ---------- Auditoria ----------

model AuditLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid // null = ação da plataforma (invisível para os tenants)
  userId    String?  @map("user_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  data      Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}
